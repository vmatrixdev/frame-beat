# AMV Maker Environment Variables

# Gemini API Key for AI Director orchestration (Phase 2)
# Get your key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default LLM Model (default: gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Optional: Hardware Acceleration for FFmpeg on macOS
# Options: auto (default), h264_videotoolbox, none
FFMPEG_HWACCEL=auto
